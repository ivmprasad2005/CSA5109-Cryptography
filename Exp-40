#include <stdio.h>
#include <ctype.h>

int main(void)
{
    char cipher[5000];

    printf("Enter ciphertext:\n");
    fgets(cipher, sizeof(cipher), stdin);

    int top;

    printf("Number of possible plaintexts: ");
    scanf("%d", &top);

    /*
       English letter frequency:
       E T A O I N S H R D L C U M W F G Y P B V K J X Q Z
    */

    char english[] =
        "ETAOINSHRDLCUMWFGYPBVKJXQZ";

    int freq[26] = {0};
    int order[26];

    for (int i = 0; cipher[i]; i++)
        if (isalpha(cipher[i]))
            freq[toupper(cipher[i]) - 'A']++;

    for (int i = 0; i < 26; i++)
        order[i] = i;

    for (int i = 0; i < 25; i++)
    {
        for (int j = i + 1; j < 26; j++)
        {
            if (freq[order[j]] > freq[order[i]])
            {
                int t = order[i];
                order[i] = order[j];
                order[j] = t;
            }
        }
    }

    char map[26];

    for (int i = 0; i < 26; i++)
        map[order[i]] = english[i];

    printf("\nPossible plaintext #1:\n");

    for (int i = 0; cipher[i]; i++)
    {
        if (isalpha(cipher[i]))
            putchar(map[toupper(cipher[i]) - 'A']);
        else
            putchar(cipher[i]);
    }

    printf("\n\nNote: Simple frequency analysis alone cannot reliably\n");
    printf("solve every monoalphabetic substitution cipher. A practical\n");
    printf("automatic solver uses digram/trigram/tetragram statistics\n");
    printf("or an English word-frequency dictionary.\n");

    return 0;
}
