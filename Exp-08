#include <stdio.h>
#include <ctype.h>

int main(void)
{
    char text[10000];
    int freq[256] = {0};

    printf("Enter ciphertext:\n");
    fgets(text, sizeof(text), stdin);

    for (int i = 0; text[i]; i++)
        freq[(unsigned char)text[i]]++;

    printf("\nCharacter frequencies:\n");

    for (int i = 0; i < 256; i++)
        if (freq[i])
            printf("%c : %d\n",
                   isprint(i) ? i : '?', freq[i]);

    return 0;
}
