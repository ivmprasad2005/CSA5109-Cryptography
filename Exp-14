#include <stdio.h>
#include <ctype.h>

int main(void)
{
    char plaintext[] = "SEND MORE MONEY";

    int key[] = {
        9,0,1,7,23,15,21,14,11,11,2,8,9
    };

    int j = 0;

    printf("Ciphertext: ");

    for (int i = 0; plaintext[i]; i++)
    {
        if (isalpha(plaintext[i]))
        {
            int p = toupper(plaintext[i]) - 'A';
            int c = (p + key[j++]) % 26;

            putchar(c + 'A');
        }
        else
        {
            putchar(plaintext[i]);
        }
    }

    printf("\n");

    return 0;
}
