#include <stdio.h>

int main(void)
{
    int shifts[16] =
        {1,1,2,2,2,2,2,2,1,2,2,2,2,2,2,1};

    printf("DES decryption key order:\n");

    for (int i = 15; i >= 0; i--)
        printf("K%d ", i + 1);

    printf("\n\nReverse shift schedule:\n");

    for (int i = 15; i >= 0; i--)
        printf("%d ", shifts[i]);

    printf("\n");

    return 0;
}
