#include <stdio.h>

int mod26(int x)
{
    return (x % 26 + 26) % 26;
}

int inverse(int x)
{
    for (int i = 1; i < 26; i++)
        if (mod26(x * i) == 1)
            return i;

    return -1;
}

int main(void)
{
    int P[2][2];
    int C[2][2];

    printf("Enter plaintext matrix P:\n");

    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 2; j++)
            scanf("%d", &P[i][j]);

    printf("Enter ciphertext matrix C:\n");

    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 2; j++)
            scanf("%d", &C[i][j]);

    int det = mod26(P[0][0] * P[1][1] -
                    P[0][1] * P[1][0]);

    int d = inverse(det);

    if (d == -1)
    {
        printf("P has no inverse modulo 26.\n");
        return 1;
    }

    int I[2][2];

    I[0][0] = mod26(P[1][1] * d);
    I[0][1] = mod26(-P[0][1] * d);
    I[1][0] = mod26(-P[1][0] * d);
    I[1][1] = mod26(P[0][0] * d);

    int K[2][2] = {0};

    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 2; j++)
            for (int k = 0; k < 2; k++)
                K[i][j] =
                    mod26(K[i][j] + C[i][k] * I[k][j]);

    printf("Recovered key:\n");

    for (int i = 0; i < 2; i++)
        printf("%d %d\n", K[i][0], K[i][1]);

    return 0;
}
