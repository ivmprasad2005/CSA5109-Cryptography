#include <stdio.h>
#include <stdint.h>

uint64_t leftshift64(uint64_t x)
{
    return x << 1;
}

__uint128_t leftshift128(__uint128_t x)
{
    return x << 1;
}

int main(void)
{
    printf("CMAC constants:\n");
    printf("64-bit block  : Rb = 0x1B\n");
    printf("128-bit block : Rb = 0x87\n");

    printf("\nFor a left shift:\n");
    printf("If the most significant bit is 0, shift left by one.\n");
    printf("If the most significant bit is 1, XOR with Rb afterward.\n");

    return 0;
}
