#include <stdio.h>
#include <ctype.h>

int main(void)
{
    char plaintext[500];
    int key[500];

    int n;

    printf("Enter plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);

    printf("Enter number of key values: ");
    scanf("%d", &n);

    printf("Enter key stream:\n");

    for (int i = 0; i < n; i++)
        scanf("%d", &key[i]);

    int k = 0;

    printf("Ciphertext: ");

    for (int i = 0; plaintext[i]; i++)
    {
        if (isalpha(plaintext[i]))
        {
            int p = toupper(plaintext[i]) - 'A';
            int c = (p + key[k++]) % 26;

            putchar(c + 'A');
        }
        else
            putchar(plaintext[i]);
    }

    printf("\n");

    return 0;
}
