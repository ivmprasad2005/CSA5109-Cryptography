#include <stdio.h>

int mod26(int x)
{
    return (x % 26 + 26) % 26;
}

int inverse(int a)
{
    for (int i = 1; i < 26; i++)
        if (mod26(a * i) == 1)
            return i;

    return -1;
}

int main(void)
{
    /*
       Known plaintext/ciphertext matrices

       P = [ p1 p2 ]
           [ p3 p4 ]

       C = K P

       Therefore:
       K = C * P^-1
    */

    int P[2][2] = {
        {7,4},
        {11,15}
    };

    int C[2][2] = {
        {3,8},
        {10,21}
    };

    int det = mod26(P[0][0]*P[1][1] -
                    P[0][1]*P[1][0]);

    int invdet = inverse(det);

    if (invdet == -1)
    {
        printf("Plaintext matrix is not invertible modulo 26.\n");
        return 1;
    }

    int Pinv[2][2];

    Pinv[0][0] = mod26(P[1][1] * invdet);
    Pinv[0][1] = mod26(-P[0][1] * invdet);
    Pinv[1][0] = mod26(-P[1][0] * invdet);
    Pinv[1][1] = mod26(P[0][0] * invdet);

    int K[2][2];

    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 2; j++)
        {
            K[i][j] = 0;

            for (int k = 0; k < 2; k++)
                K[i][j] += C[i][k] * Pinv[k][j];

            K[i][j] = mod26(K[i][j]);
        }

    printf("Recovered Hill key:\n");

    for (int i = 0; i < 2; i++)
        printf("%d %d\n", K[i][0], K[i][1]);

    return 0;
}
