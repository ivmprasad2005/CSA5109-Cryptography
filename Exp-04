#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char text[500], key[100];
    int keyLen, j = 0;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter key: ");
    scanf("%99s", key);

    keyLen = strlen(key);

    for (int i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            int shift = toupper(key[j % keyLen]) - 'A';

            if (isupper(text[i]))
                text[i] = 'A' + (text[i] - 'A' + shift) % 26;
            else
                text[i] = 'a' + (text[i] - 'a' + shift) % 26;

            j++;
        }
    }

    printf("Ciphertext: %s", text);

    return 0;
}
